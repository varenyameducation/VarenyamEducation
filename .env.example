# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database
DATABASE_URL=
DIRECT_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=86400
JWT_REFRESH_EXPIRES_IN=604800

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=

# App
NEXT_PUBLIC_APP_URL=
NODE_ENV=development

# Gemini (Google AI Studio) — optional
# Free API key from https://aistudio.google.com/app/apikey (free tier: 1500 req/day).
# Used by /api/questions/parse-image to extract question_body / question_type / options
# from an uploaded question image, with math converted to LaTeX. When unset, the
# image-upload endpoint returns a friendly 400 — the rest of the app keeps working.
GEMINI_API_KEY=

# Browserless.io API token for PDF generation
# Sign up at https://browserless.io — free tier: ~1000 PDFs/month
BROWSERLESS_TOKEN=

# Optional: override Browserless endpoint (defaults to chrome.browserless.io)
# Useful if you provision a dedicated instance later
BROWSERLESS_URL=
