# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database
DATABASE_URL=
DIRECT_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=86400
JWT_REFRESH_EXPIRES_IN=604800

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=

# App
NEXT_PUBLIC_APP_URL=
NODE_ENV=development

# Gemini (Google AI Studio) — optional
# Free API key from https://aistudio.google.com/app/apikey (free tier: 1500 req/day).
# Used by /api/questions/parse-image to extract question_body / question_type / options
# from an uploaded question image, with math converted to LaTeX. When unset, the
# image-upload endpoint returns a friendly 400 — the rest of the app keeps working.
GEMINI_API_KEY=

# PDF export — local dev only
# puppeteer-core does not download a browser of its own. In local dev,
# point this at the system Chrome/Edge binary so /api/tests/[id]/export/pdf
# can launch it. On Vercel this is ignored — @sparticuz/chromium ships a
# serverless-friendly Chromium binary that the route uses automatically.
# Windows example:  C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS   example:  /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux   example:  /usr/bin/google-chrome
PUPPETEER_EXECUTABLE_PATH=
